<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="owenwang.ems.App">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="1011" height="929"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <splitpane id="72c6" binding="splitPane">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="200"/>
          </grid>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <resizeWeight value="1.0"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="3f9f" layout-manager="GridBagLayout">
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <scrollpane id="4b286">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="1.0"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="3d182" class="javax.swing.JTable" binding="table">
                    <constraints/>
                    <properties>
                      <fillsViewportHeight value="true"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
              <component id="bc512" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                  <gridbag top="10" left="10" bottom="10" right="10" weightx="0.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Search for Employee #:"/>
                </properties>
              </component>
              <component id="a3064" class="javax.swing.JTextField" binding="searchField">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties/>
              </component>
              <component id="2431b" class="javax.swing.JButton" binding="searchButton" default-binding="true">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                  <gridbag top="10" left="10" bottom="10" right="10" weightx="0.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <icon value="owenwang/ems/edit-find.png"/>
                  <text value="Search"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="c920c" binding="detailsPane" layout-manager="CardLayout" hgap="0" vgap="0">
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <nested-form id="761b1" form-file="owenwang/ems/EmployeeDetails.form" binding="employeeDetails">
                <constraints>
                  <card name="SingleSelect"/>
                </constraints>
              </nested-form>
              <grid id="1aa2d" layout-manager="GridBagLayout">
                <constraints>
                  <card name="MultiSelect"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="21eba" class="javax.swing.JSeparator">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                      <gridbag weightx="0.0" weighty="0.0"/>
                    </constraints>
                    <properties/>
                  </component>
                  <vspacer id="7d798">
                    <constraints>
                      <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                      <gridbag weightx="0.0" weighty="1.0"/>
                    </constraints>
                  </vspacer>
                  <component id="3c972" class="javax.swing.JLabel" binding="multiSelectLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="10" fill="0" indent="0" use-parent-layout="false"/>
                      <gridbag top="10" left="10" bottom="5" right="10" weightx="1.0" weighty="0.0"/>
                    </constraints>
                    <properties>
                      <font size="16" style="1"/>
                      <icon value="owenwang/ems/system-users.png"/>
                      <text value="X Employees"/>
                    </properties>
                  </component>
                  <component id="e5eee" class="javax.swing.JSeparator">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="6" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
                      <gridbag weightx="0.0" weighty="0.0"/>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="3722b" class="javax.swing.JButton" binding="removeAllButton">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                      <gridbag top="5" left="10" bottom="5" right="10" weightx="1.0" weighty="0.0"/>
                    </constraints>
                    <properties>
                      <icon value="owenwang/ems/edit-delete.png"/>
                      <text value="Remove All"/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
        </children>
      </splitpane>
      <toolbar id="219d3">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="20"/>
          </grid>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <borderPainted value="false"/>
          <floatable value="false"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="a879" class="javax.swing.JButton" binding="addEmployeeButton" default-binding="true">
            <constraints/>
            <properties>
              <icon value="owenwang/ems/list-add-user.png"/>
              <text value="Add Employee"/>
            </properties>
          </component>
          <component id="7930b" class="javax.swing.JToolBar$Separator">
            <constraints/>
            <properties/>
          </component>
          <component id="8d4fc" class="javax.swing.JButton" binding="newButton">
            <constraints/>
            <properties>
              <icon value="owenwang/ems/document-new.png"/>
              <text value="New"/>
            </properties>
          </component>
          <component id="353c6" class="javax.swing.JButton" binding="saveButton">
            <constraints/>
            <properties>
              <icon value="owenwang/ems/document-save.png"/>
              <text value="Save"/>
            </properties>
          </component>
          <component id="691e" class="javax.swing.JButton" binding="saveAsButton">
            <constraints/>
            <properties>
              <icon value="owenwang/ems/document-save-as.png"/>
              <text value="Save As..."/>
            </properties>
          </component>
          <component id="e9825" class="javax.swing.JButton" binding="openButton">
            <constraints/>
            <properties>
              <icon value="owenwang/ems/document-open.png"/>
              <text value="Open..."/>
            </properties>
          </component>
        </children>
      </toolbar>
    </children>
  </grid>
  <buttonGroups>
    <group name="afdsf">
